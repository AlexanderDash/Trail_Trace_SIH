# Copy values into apps/api/.env for local development.
# Foundation stage uses SQLite so the prototype runs without PostgreSQL.

# --- API (apps/api/.env) ---
PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CORS_ORIGIN="http://localhost:5173"

# --- Web (optional; Vite defaults to the /api proxy) ---
# VITE_API_BASE_URL=http://localhost:3001/api/v1
